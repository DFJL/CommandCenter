{
  "name": "CommandCenter R Shiny",
  "image": "rocker/shiny:4.3.3",
  "forwardPorts": [3838],
  "portsAttributes": {
    "3838": {
      "label": "Shiny App",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "Rscript -e \"install.packages(c('bslib','plotly','DT','randomForest','stringr','tidyr'), repos='https://packagemanager.posit.co/cran/__linux__/jammy/latest', Ncpus=4)\"",
  "postStartCommand": "cd /workspaces/CommandCenter && Rscript run.R &",
  "customizations": {
    "vscode": {
      "extensions": ["REditorSupport.r"]
    }
  }
}
